{
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/app.html",
      "has": [
        {
          "type": "host",
          "value": "app.nyrealtorjoy.com"
        }
      ]
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/((?!sitemap.xml|robots.txt|llm.txt|favicon.ico|.*\\..*).*)",
      "destination": "/index.html"
    }
  ]
}
